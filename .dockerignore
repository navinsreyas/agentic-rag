# Secrets — never bake these into the image (Cloud Run injects env vars at runtime)
.env
.env.*
!.env.example

# Version control / CI
.git
.gitignore
.github

# Virtualenvs
venv/
venv_*/
.venv/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data / corpora / generated artifacts (not needed at runtime)
documents/
big_tech_docs/
graph_progress.json
page_index.json
# NOTE: pageindex_trees/ is intentionally NOT ignored — pageindex_trees/index.json
# is the PageIndex manifest (cloud doc_ids + paths, no secrets) and must ship in
# the image so pageindex_search works in production instead of short-circuiting.

# Frontend (separate Vercel deploy — not part of the Python backend image)
frontend/
node_modules/

# Personal / dev-only
for_me.md
CLAUDE.md
test_pageindex_response.py

# Docker
Dockerfile
.dockerignore
