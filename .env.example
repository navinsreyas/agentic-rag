# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_rag
# Example: postgresql://raguser:ragpass123@localhost:5432/agentic_rag_db

# Neo4j Configuration for Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM Provider Configuration
# Groq is the documented primary provider. Set to groq, openai, openrouter, ollama, or gemini.
# IMPORTANT: LLM_PROVIDER=groq instantiates GroqModel (native JSON tool-calls);
# any other value uses OpenAIModel even if LLM_BASE_URL points at Groq.
LLM_PROVIDER=groq

# Base URL for the provider's OpenAI-compatible endpoint
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
# Ollama (example): http://localhost:11434/v1
# OpenRouter: https://openrouter.ai/api/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta
LLM_BASE_URL=https://api.groq.com/openai/v1

# API Key for LLM provider
# Groq: https://console.groq.com/keys  (keys start with gsk_)
# OpenAI: https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
# OpenRouter: Get your API Key here after registering: https://openrouter.ai/keys
# Ollama: No need to set this unless you specifically configured an API key
# Gemini: Get your API key from Google AI Studio
LLM_API_KEY=gsk_your_groq_key_here

# The LLM you want to use for the agents. Make sure this LLM supports tools!
# Groq example: llama-3.3-70b-versatile  (primary model documented in README)
# OpenAI example: gpt-4.1-mini
# OpenRouter example: anthropic/claude-3-5-sonnet
# Ollama example: qwen2.5:14b-instruct
# Gemini example: gemini-2.5-flash
LLM_CHOICE=llama-3.3-70b-versatile

# Embedding Provider Configuration
# Set this to either openai or ollama (openrouter/gemini don't have embedding models)
EMBEDDING_PROVIDER=openai

# Base URL for embedding models
# OpenAI: https://api.openai.com/v1
# Ollama: http://localhost:11434/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1

# API Key for embedding provider
EMBEDDING_API_KEY=sk-your-api-key-here

# The embedding model you want to use for RAG
# OpenAI example: text-embedding-3-small
# Ollama example: nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion-specific LLM (can be different/faster model for processing)
# Leave empty to use the same as LLM_CHOICE
INGESTION_LLM_CHOICE=gpt-4.1-nano

# Graph ingestion LLM — used by Graphiti for entity/relationship extraction.
# MUST support response_format: json_schema (structured outputs).
# If unset, falls back to LLM_CHOICE.
# Groq:   llama-3.1-8b-instant   (supports structured outputs)
#         NOT llama-3.3-70b-versatile (does NOT support structured outputs)
# OpenAI: any model works (gpt-4o-mini recommended for cost)
GRAPH_LLM_CHOICE=llama-3.1-8b-instant

# Fallback LLM (used automatically if primary model fails with a tool-call or rate-limit error)
# Set FALLBACK_LLM_PROVIDER to enable. Leave blank to disable fallback entirely.
# Recommended: use OpenAI gpt-4o-mini as a reliable fallback when running Groq as primary.
# FALLBACK_LLM_API_KEY can be the same key as EMBEDDING_API_KEY if both use OpenAI.
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_API_KEY=sk-your-openai-api-key-here
FALLBACK_LLM_CHOICE=gpt-4o-mini
FALLBACK_LLM_BASE_URL=https://api.openai.com/v1

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058

# Chunking Configuration (optimized for Graphiti token limits)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=1500

# Vector Search Configuration
VECTOR_DIMENSION=1536  # For OpenAI text-embedding-3-small
MAX_SEARCH_RESULTS=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# File Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=.md,.txt

# Debug Configuration
DEBUG_MODE=false
ENABLE_PROFILING=false

# PageIndex Configuration (cloud API — https://pageindex.ai)
# Used by ingestion/ingest_pageindex.py and agent/tools.py (pageindex_search tool).
# Get your API key at https://pageindex.ai after registering.
# NOTE: PAGEINDEX_MODEL is NOT used — model selection is managed server-side by VectifyAI.
#       The cloud API builds the document tree; you only hold doc_id pointers locally.
PAGEINDEX_API_KEY=pi_your_key_here